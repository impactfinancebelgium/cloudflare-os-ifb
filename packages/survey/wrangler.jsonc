{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "survey",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  // Reachable on workers.dev; survey.impactfinance.be is a later, deliberate step.
  "workers_dev": true,
  "preview_urls": false,
  // D1 `ifb-survey`, created 2026-08-08 with --location weur (region WEUR confirmed at
  // creation). Database id is an identifier, not a secret. D1 admin ops (create/execute)
  // need the account-wide token; the ifb-os-deploy token covers the worker deploy only.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ifb-survey",
      "database_id": "d2a2a9ba-ba20-4d80-b554-60eed8bdc4bd"
    }
  ],
  // Secrets installed with `wrangler secret put --name ifb-os-survey`:
  //   SURVEY_TOKEN_SECRET  (HMAC key for invite tokens; vault item "Survey token secret")
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
