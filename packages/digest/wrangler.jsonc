{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "digest",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  // digest.impactfinance.net, behind Cloudflare Access. workers.dev is off: the
  // admin routes can purge and refetch, so this must never be reachable without a login.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "digest.impactfinance.net", "custom_domain": true }
  ],
  // One object holds the whole stream; it wakes itself hourly via its own alarm,
  // so this worker needs no cron trigger.
  "migrations": [
    { "tag": "v0", "new_sqlite_classes": ["DigestStore"] }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DIGEST", "class_name": "DigestStore" }
    ]
  },
  // Secret installed with `wrangler secret put --name ifb-digest`:
  //   BRIEF_TOKEN  (bearer secret for /api/brief, read by the Hermes morning brief)
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
