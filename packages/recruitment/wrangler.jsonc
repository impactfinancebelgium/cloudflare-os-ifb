{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ifb-os-recruitment",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  // Reachable on workers.dev for the build/verify phase; recruitment.impactfinance.be and
  // the deploy-pipeline registration are the later cutover step.
  "workers_dev": true,
  "preview_urls": false,
  // D1 `ifb-recruitment` (create with --location weur). database_id filled in after creation.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ifb-recruitment",
      "database_id": "0177ccda-7538-4f42-92cb-ff5737936cc8"
    }
  ],
  // Reuse the existing private CV bucket that /api/apply already writes to.
  "r2_buckets": [
    {
      "binding": "CVS",
      "bucket_name": "ifb-applications"
    }
  ],
  // Secrets installed with `wrangler secret put --name ifb-os-recruitment`:
  //   ADMIN_KEY      gates the staff review API (until Cloudflare Access wraps it at cutover)
  //   SCREEN_TOKEN   gates POST /api/screen
  //   GOOGLE_API_KEY Gemini key for CV screening
  //   RESEND_API_KEY optional; applicant acknowledgement email
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
