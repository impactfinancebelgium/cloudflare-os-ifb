{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "scheduler",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["SchedulerGatekeeper"]
    }
  ],
  // The union of every cron expression used in src/jobs.ts. Cron triggers are static
  // Worker config, so keep this list and the job table in sync; index.ts logs a warning
  // when it fires for a cron no job matches.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
