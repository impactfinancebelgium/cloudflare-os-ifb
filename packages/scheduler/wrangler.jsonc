{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": false,
  // The union of every cron expression used in src/jobs.ts. Cron triggers are static
  // Worker config, so keep this list and the job table in sync; index.ts logs a warning
  // when it fires for a cron no job matches.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
