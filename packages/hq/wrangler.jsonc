{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hq",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  // hq.impactfinance.net, behind a Cloudflare Access application. workers.dev is
  // off: this page lists the whole estate, so it should only ever be reachable
  // through the Access login.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "hq.impactfinance.net", "custom_domain": true }
  ],
  "migrations": [
    { "tag": "v0", "new_sqlite_classes": ["HqStore"] }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "HQ", "class_name": "HqStore" }
    ]
  },
  // Secret installed with `wrangler secret put --name ifb-hq`:
  //   HQ_TOKEN  (bearer secret for POST /api/projects; vault item "ifb-hq project token")
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
