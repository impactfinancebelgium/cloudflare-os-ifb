{
  // Cloudflare account that owns every Worker and provisioned resource.
  // Find it: https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/
  "accountId": "4fd93a4887e7982e732c9df8ed51ea21",

  // Worker names are permanent service identities. Keep them unique within the account.
  // Reference: docs/customization.md#workers-and-routing
  "workers": {
    "workshop": {
      "name": "ifb-os",

      // Production: use a hostname in an active Cloudflare zone. Wrangler creates DNS and TLS.
      // Evaluation: replace this with "route": { "workersDev": true }.
      // https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
      "route": { "customDomain": "os.impactfinance.be" }
    },
    "context": { "name": "ifb-os-context" },
    "customGatekeeper": { "name": "ifb-os-gatekeeper" },
    "errorReporter": { "name": "ifb-os-errors" },
    "scheduler": { "name": "ifb-os-scheduler" },
    "edge": { "name": "ifb-os-edge" },
    "twentyGatekeeper": { "name": "ifb-os-twenty-gatekeeper" },
    "websiteGatekeeper": { "name": "ifb-os-website-gatekeeper" },
    "sharepointGatekeeper": { "name": "ifb-os-sharepoint-gatekeeper" },
    "survey": { "name": "ifb-os-survey" }
  },

  // This starter deploys Cloudflare Access mode. Cloudflare OS also supports built-in password
  // accounts and auth Gatekeeper sign-in; see the reference below before switching. The audience
  // comes from the self-hosted Access application protecting the Workshop hostname.
  // "admins" gates /admin in every sign-in method.
  // Reference: docs/customization.md#sign-in-methods
  "access": {
    "issuer": "https://aged-cherry-4437.cloudflareaccess.com",
    "audience": "4c17b3fe12257f08722b9acba9723e3cae8266bf7839bfee3e8909069d68e33a",
    "admins": ["jonas@sparkcollective.be", "lynn@impactfinance.be"]
  },

  // Optional platform-funded model catalog. Leave disabled to deploy without AI setup.
  // When enabled, replace every placeholder and install CF_AI_GATEWAY_API_TOKEN separately.
  // Reference: docs/customization.md#ai-models
  "aiGateway": {
    "enabled": true,
    "name": "ifb-os",
    "accountId": "4fd93a4887e7982e732c9df8ed51ea21",
    "providers": ["cloudflare", "openrouter"],

    // "direct" sends Workers AI to its REST endpoint. "gateway" adds AI Gateway logs.
    "workersAi": { "mode": "gateway", "gateway": "ifb-os" }
  },

  "context": {
    // Isolates Context data shared by this Workshop deployment.
    "sharingDomain": "production",

    // null: Wrangler provisions and remembers a KV namespace on first deploy.
    // string: bind an existing namespace by ID.
    "kvNamespaceId": "f2a1da329ed14852bc85d6d7e84b10c2"
  },

  // Displayed to agents when the example custom integration is enabled in /admin.
  // Reference: docs/customization.md#custom-gatekeepers
  "customGatekeeper": {
    "name": "Impact Finance Belgium",
    "message": "IFB is a membership organisation for impact finance in Belgium. Follow the IFB voice: plain, numerate, British spelling. Anything member-facing is a draft until a human approves it."
  },

  // Explicit backend issue reports go to a private Worker that emits structured console errors.
  // Set release to a commit/version when your deployment pipeline has one.
  // Reference: docs/observability.md#quick-start
  // IFB: git-defined scheduled jobs (packages/scheduler). See jobs.ts for the table.
  "scheduler": { "enabled": true },

  // IFB: the three Supabase Edge Functions ported to a Worker (packages/edge), STAGED
  // for the Supabase exit. cutover:false keeps every route answering 503; flipping it
  // to true (plus repointing the website + Resend webhook) is the cutover decision.
  "edge": {
    "enabled": true,
    "cutover": true,  // Jonas approved the Supabase cutover 2026-08-08
    "supabaseUrl": "https://bogiknzxejjhndthnzgg.supabase.co",
    "resendAudienceId": "bb256ad9-171a-4293-a631-212a15668bc6",
    "twentyBaseUrl": "https://crm.impactfinance.be"
  },

  // IFB: read-only Twenty CRM gatekeeper (packages/twenty-gatekeeper). Secrets on the
  // ifb-os-twenty-gatekeeper worker: TWENTY_API_KEY + the ifb-os-twenty Access service
  // token pair (all in the IFB 1Password vault).
  "twentyGatekeeper": { "enabled": true },

  // IFB: website change-proposal gatekeeper (packages/website-gatekeeper). Reads the
  // public website repo; writes only as human-approved review branches. Secret on the
  // worker: WEBSITE_GITHUB_TOKEN (org fine-grained PAT from the IFB vault).
  "websiteGatekeeper": { "enabled": true },

  // IFB: read-only SharePoint gatekeeper (packages/sharepoint-gatekeeper). Graph
  // client credentials via the "IFB Workspace" Entra app; Sites.Selected confines it
  // to the IFB site. Secret on the worker: MS_CLIENT_SECRET (IFB vault).
  "sharepointGatekeeper": { "enabled": true },

  // IFB: member survey app (packages/survey). Worker + D1 `ifb-survey` (region WEUR).
  // Member auth is signed invite tokens, never Cloudflare Access (per-seat cost).
  "survey": { "enabled": true },

  "errorReporting": {
    "enabled": true,
    "environment": "production",
    "release": null
  },

  // null values use Wrangler automatic provisioning. Set IDs/names to reuse owned resources.
  // https://developers.cloudflare.com/workers/wrangler/configuration/#automatic-provisioning
  "resources": {
    "blueprintsKvNamespaceId": "271b0054315a45eb90abb576ff4e6be6",
    "avatarsKvNamespaceId": "14a65640c3d941849e1e50565da9cbaf",
    "blueprintContentBucket": "ifb-os-blueprint-content"
  },

  // Structured custom logs stay enabled. Invocation logs and traces are separate volume controls.
  // https://developers.cloudflare.com/workers/observability/logs/workers-logs/
  "observability": {
    "enabled": true,
    "headSamplingRate": 1,
    "logs": { "invocationLogs": false },
    "traces": { "enabled": false, "headSamplingRate": 0.1 }
  }
}
